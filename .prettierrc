{
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "auto",
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": [
    "^./polyfills$",
    "^react$",
    "<THIRD_PARTY_MODULES>",
    "^@/(constants|abi|types)(.*)$",
    "^@/(hooks|contexts|providers)(.*)$",
    "^@/(styles|assets)(.*)$",
    "^@/(components|pages)(.*)$",
    "^@/state(.*)$",
    "^@/lib(.*)$",
    "^@/utils(.*)$",
    "^[./]"
  ],
  "importOrderSeparation": true
}
